When the first argument of process() is a function, it runs in the child
process, receives the argument vector and the environment, and returns the
argument vector to execute. Changes to the environment apply to the executed
program. exit() in the function sets the exit code of the child. An exception
or a return value that is not a non-empty array makes the child exit with code
255. Buffered output of the parent is written once, and SIGTERM ends the
child.

-- Testcase --
{%
	import * as uloop from 'uloop';
	import * as fs from 'fs';

	uloop.init();

	const tmpdir = fs.mkdtemp('./ucode-uloop-process-XXXXXX');
	const outfile = tmpdir + '/out';

	function run(label, executable, args, env) {
		let completed = false;
		let child = uloop.process(executable, args, env, (status) => {
			completed = true;
			printf('%s: %d\n', label, status);
			uloop.end();
		});

		if (!child)
			die('Unable to start child');

		uloop.run();

		if (!completed)
			die('Missing process callback');
	}

	run('argv', (args, env) => {
		let out = fs.open(outfile, 'w');
		fs.dup2(out.fileno(), 1);
		out.close();

		env.GREETING = 'changed';

		return ['/bin/sh', '-c', 'echo "$0 $1 $GREETING"; exit 3', ...args];
	}, ['first', 'second'], { GREETING: 'initial' });

	print(fs.readfile(outfile));
	fs.unlink(outfile);
	fs.rmdir(tmpdir);

	run('exception', () => die('setup failed'));
	run('null', () => null);
	run('empty', () => []);
	run('string', () => '/bin/true');
	run('exit', () => exit(3));

	printf('buffered before fork\n');
	run('flush', () => {
		fs.stdout.flush();
		return ['/bin/true'];
	});

	let ready = fs.pipe(), resume = fs.pipe();

	function signal_wait() {
		ready[1].write('x');
		ready[1].flush();
		resume[0].read(1);

		return ['/bin/true'];
	}

	// The signal must find the child in its function: wait for its report.
	// A child that the signal did not end goes on and exits with code 0.
	function signal_send(child, signal) {
		ready[1].close();

		// a signal for the parent, like SIGCHLD, interrupts the read
		for (let i = 0; i < 100 && ready[0].read(1) == null; i++)
			continue;

		system(['kill', signal, `${child.pid()}`]);
		resume[1].write('x');
		resume[1].flush();
	}

	uloop.timer(1, () => {
		let child = uloop.process(signal_wait, null, null, (status) => {
			printf('TERM: %d\n', status);
			uloop.end();
		});

		signal_send(child, '-TERM');
	});

	uloop.run();

	printf('invalid: %J\n', uloop.process(123, null, null, () => null));

	uloop.done();
%}
-- End --

-- Expect stdout --
argv: 3
first second changed
exception: 255
null: 255
empty: 255
string: 255
exit: 3
buffered before fork
flush: 0
TERM: -15
invalid: null
-- End --


Signals received by the child do not reach the signal callbacks of the
parent.

-- Testcase --
{%
	import * as uloop from 'uloop';
	import * as fs from 'fs';

	if (!uloop.signal)
		exit(77);

	uloop.init();

	let usr1_count = 0, child_status;
	let usr1 = uloop.signal('SIGUSR1', () => usr1_count++);
	let ready = fs.pipe(), resume = fs.pipe();

	function signal_wait() {
		ready[1].write('x');
		ready[1].flush();
		resume[0].read(1);

		return ['/bin/true'];
	}

	// The signal must find the child in its function: wait for its report.
	function signal_send(child, signal) {
		ready[1].close();

		// a signal for the parent, like SIGCHLD, interrupts the read
		for (let i = 0; i < 100 && ready[0].read(1) == null; i++)
			continue;

		system(['kill', signal, `${child.pid()}`]);
		resume[1].write('x');
		resume[1].flush();
	}

	uloop.timer(1, () => {
		let child = uloop.process(signal_wait, null, null, (status) => {
			child_status = status;
			uloop.end();
		});

		signal_send(child, '-USR1');
	});

	uloop.run();

	// A signal that the child passed to the parent is an event of the loop,
	// which can come after the exit of the child.
	for (let i = 0; i < 3; i++)
		uloop.run(0);

	printf('USR1: %d, parent callbacks: %d\n', child_status, usr1_count);

	usr1.delete();
	uloop.done();
%}
-- End --

-- Expect stdout --
USR1: 0, parent callbacks: 0
-- End --
