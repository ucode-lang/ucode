Handles, processes and tasks are released by the event loop once they are
finished, so that they are freed as soon as the script drops its last
reference. A handle is finished when the event loop removes its descriptor
after an error or hangup.

-- Testcase --
{%
	import * as uloop from 'uloop';
	import * as fs from 'fs';

	uloop.init();

	// With an old libubox, uloop.run() with a timeout returns only when the
	// loop ends: end the loop from a timer.
	function run(msecs) {
		uloop.timer(msecs, () => uloop.end());
		uloop.run();
	}

	// A host under load needs an unknown time until the process and the task
	// ended: run the loop until the state is there.
	function loop_until(done) {
		for (let limit = time() + 10; !done() && time() < limit; )
			run(10);
	}

	let events = [];
	let base_fds = length(fs.lsdir('/dev/fd'));
	let base = gc('count');

	let fds = fs.pipe();

	uloop.handle(fds[0], (flags, eof, error) => {
		push(events, sprintf("handle error=%s", error));
	}, uloop.ULOOP_READ);

	fds[1].close();
	fds = null;

	uloop.process('/bin/sh', ['-c', 'exit 3'], null, (status) => {
		push(events, sprintf("process status=%d", status));
	});

	uloop.task(
		(pipe) => 'done',
		(msg) => push(events, sprintf("task output=%s", msg))
	);

	// the released handle and the finished task close their descriptors
	loop_until(() => length(events) == 3 &&
		length(fs.lsdir('/dev/fd')) == base_fds);

	printf("%s\nalive: %d\n", join('\n', sort(events)), gc('count') - base);

	uloop.done();
%}
-- End --

-- Expect stdout --
handle error=true
process status=3
task output=done
alive: 0
-- End --


Handles registered with ULOOP_ERROR_CB stay registered until they are
deleted, even without a script reference.

-- Testcase --
{%
	import * as uloop from 'uloop';
	import * as fs from 'fs';

	uloop.init();

	// With an old libubox, uloop.run() with a timeout returns only when the
	// loop ends: end the loop from a timer.
	function run(msecs) {
		uloop.timer(msecs, () => uloop.end());
		uloop.run();
	}

	// A run whose timer is due at its start ends before it reports a hangup:
	// run the loop until the state is there.
	function loop_until(done) {
		for (let limit = time() + 10; !done() && time() < limit; )
			run(10);
	}

	let base = gc('count');
	let fds = fs.pipe();
	let hangups = 0;

	uloop.handle(fds[0], function(flags, eof, error) {
		if (error && ++hangups == 2)
			this.delete();
	}, uloop.ULOOP_READ | uloop.ULOOP_ERROR_CB);

	fds[1].close();
	fds = null;

	printf("registered: %s\n", gc('count') > base);

	loop_until(() => hangups >= 2);

	// a handle that is still registered reports more hangups
	run(10);

	printf("hangups: %d, alive: %d\n", hangups, gc('count') - base);

	uloop.done();
%}
-- End --

-- Expect stdout --
registered: true
hangups: 2, alive: 0
-- End --


Intervals and signal handlers stay registered until they are cancelled or
deleted, even without a script reference.

-- Testcase --
{%
	import * as uloop from 'uloop';

	if (!uloop.interval || !uloop.signal)
		exit(77);

	uloop.init();

	// the signal callback ends a run before its timer
	function run(msecs) {
		let timer = uloop.timer(msecs, () => uloop.end());

		uloop.run();
		timer.cancel();
	}

	// A host under load needs an unknown time for three ticks and for the
	// signal: run the loop until the state is there.
	function loop_until(done) {
		for (let limit = time() + 10; !done() && time() < limit; )
			run(10);
	}

	let base = gc('count');
	let ticks = 0, signalled = false;

	uloop.interval(1, function() {
		if (++ticks == 3)
			this.cancel();
	});

	uloop.signal('SIGUSR1', function() {
		printf("signal received\n");
		this.delete();
		signalled = true;
		uloop.end();
	});

	printf("registered: %s\n", gc('count') > base);

	loop_until(() => ticks >= 3);
	system('kill -USR1 $PPID');
	loop_until(() => signalled);

	// an interval that is still armed ticks in a further run
	run(15);

	printf("ticks: %d, alive: %d\n", ticks, gc('count') - base);

	uloop.done();
%}
-- End --

-- Expect stdout --
registered: true
signal received
ticks: 3, alive: 0
-- End --
