Members of a character list may be quoted with a backslash. The engines read
a backslash within a bracket expression as an ordinary member and end the
expression at its first right bracket, so a quoted member is rewritten to a
position where it cannot be misread: a quoted right bracket moves to the front
of the list, a quoted dash and a quoted backslash to its end, where a dash
cannot denote a range. A quoted dash therefore denotes a dash instead of
turning the surrounding members into a range, and a regexp literal and the
equivalent regexp() constructor call describe the same pattern.

-- Testcase --
{%
	printf("%.J\n", [
		match("abc", /^[a\-z]+$/),
		match("a-z", /^[a\-z]+$/),
		match("-", /^[a\-z]+$/),
		match("a]b", /^[a\]b]+$/),
		match("ab]", /^[a\]b]+$/),
		match("\\", /^[a\]b]+$/),
		match("]", /^[\]]$/),
		match("\\", /^[\]]$/),
		match("a-z", regexp("^[a\\-z]+$")),
		match("-", regexp("^[a\\-z]+$")),
		match("a]b", regexp("^[a\\]b]+$")),
		match("]", regexp("^[\\]]$"))
	]);
%}
-- End --

-- Expect stdout --
[
	null,
	[
		"a-z"
	],
	[
		"-"
	],
	[
		"a]b"
	],
	[
		"ab]"
	],
	null,
	[
		"]"
	],
	null,
	[
		"a-z"
	],
	[
		"-"
	],
	[
		"a]b"
	],
	[
		"]"
	]
]
-- End --

