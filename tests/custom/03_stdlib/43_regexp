The `m` flag enables multi-line matching: `^` and `$` anchor at the beginning
and end of a line instead of the beginning and end of the subject. The dot
operator and negated character lists keep their usual meaning, which is why
`s` is needed in addition to `m` to let a dot match a newline.

-- Testcase --
{%
	printf("%.J\n", [
		match("abc\ndef", /^[a-z]+$/),
		match("abc\ndef", /^[a-z]+$/m),
		match("abc\ndef", /^def$/m),
		match("abc\ndef", /./m),
		match("abc\ndef", /^.*$/m),
		match("abc\ndef", /^.*$/ms),
		match("a\nb", /[^a]/m),
		match("a\nb", /[^a]/),
		match("a\nb", /[^[:cntrl:]]/m),
		match("a\nb", /[\n]/m),
		match("a\nb", /([^a])/m),
		match("abc\ndef", /(a)|(def)/m),
		match("abc\ndef", /(a)([^b])(c)/m),
		split("abc\ndef", /\n/m),
		replace("abc\ndef", /b/m, "X"),
		"" + /a/m,
		"" + regexp("a", "ms")
	]);
%}
-- End --

-- Expect stdout --
[
	null,
	[
		"abc"
	],
	[
		"def"
	],
	[
		"a"
	],
	[
		"abc"
	],
	[
