{%
	printf("%.J\n", [
		match("\n", /\D/m),
		match("\n", /[^[:digit:]]/m),
		match("\n", /\W/m),
		match("\n", /\d/m),
		match(" ", /\S/m),
		match("a\nb", /\D\D\D/m)
	]);
%}
-- End --

