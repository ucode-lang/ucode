The global object is constant while sort() orders its keys and while a
conversion to a string formats it. A store to a global variable from the
comparator or from a tostring method raises the same type error then.

-- Testcase --
let n = 0;

try {
	sort(global, (k1, v1, k2, v2) => { counter = ++n; return 0; });
	print("sorted\n");
}
catch (e) {
	print(e.type, ": ", e.message, "\n");
}

x = 1;
holder = proto({}, { tostring: function() { x = 2; return "y"; } });

try {
	sprintf("%s", global);
	print("formatted\n");
}
catch (e) {
	print(e.type, ": ", e.message, "\n");
}

print([ counter, x ], "\n");
-- End --

-- Args --
-R
-- End --

-- Expect stdout --
Type error: object value is immutable
Type error: object value is immutable
[ null, 1 ]
-- End --
