A function that runs with a scope whose prototype is a module namespace
finds its global variables in the namespace, which is a constant object.
A store to such a variable raises the type error of a property store on a
constant object, for an assignment, a compound assignment, an increment
and for a name that no object of the scope holds. The variable of the
module keeps its value.

-- Testcase --
import * as mod from "./files/counter.uc";

function assign() { counter = 7; return counter; }
function update() { counter += 1.5; return counter; }
function increment() { return counter++; }
function create() { other = 1; return other; }
function assign_strict() { "use strict"; counter = 7; return counter; }
function update_strict() { "use strict"; counter += 1.5; return counter; }
function read() { return counter; }

for (let fn in [ assign, update, increment, create, assign_strict, update_strict, read ]) {
	try {
		print(call(fn, null, proto({}, mod)), "\n");
	}
	catch (e) {
		print(e.type, ": ", e.message, "\n");
	}
}

print(mod.read(), "\n");

let scope = proto({ counter: 1 }, mod);

print(call(update, null, scope), " ", scope.counter, " ", mod.read(), "\n");
-- End --

-- File counter.uc --
export let counter = 5;

export function read() { return counter; };
-- End --

